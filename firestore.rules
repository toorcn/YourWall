rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validShortText(value, minLength, maxLength) {
      return value is string
        && value.size() >= minLength
        && value.size() <= maxLength;
    }

    function validOptionalText(data, field, maxLength) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function validHexColor(value) {
      return value is string && value.matches('^#[0-9a-fA-F]{6}$');
    }

    function validStringList(values, maxItems, maxLength) {
      return values is list
        && values.size() > 0
        && values.size() <= maxItems
        && validShortText(values[0], 1, maxLength)
        && (values.size() < 2 || validShortText(values[1], 1, maxLength))
        && (values.size() < 3 || validShortText(values[2], 1, maxLength))
        && (values.size() < 4 || validShortText(values[3], 1, maxLength))
        && (values.size() < 5 || validShortText(values[4], 1, maxLength))
        && (values.size() < 6 || validShortText(values[5], 1, maxLength))
        && (values.size() < 7 || validShortText(values[6], 1, maxLength))
        && (values.size() < 8 || validShortText(values[7], 1, maxLength))
        && (values.size() < 9 || validShortText(values[8], 1, maxLength))
        && (values.size() < 10 || validShortText(values[9], 1, maxLength))
        && (values.size() < 11 || validShortText(values[10], 1, maxLength))
        && (values.size() < 12 || validShortText(values[11], 1, maxLength));
    }

    function validInitialStats(stats) {
      return stats is map
        && stats.keys().hasAll(['messageCount', 'groupCount', 'totalLikes'])
        && stats.keys().hasOnly(['messageCount', 'groupCount', 'totalLikes'])
        && stats.messageCount == 0
        && stats.groupCount == 0
        && stats.totalLikes == 0;
    }

    match /spaces/{spaceCode} {
      allow get: if true;
      allow list: if false;

      allow create: if signedIn()
        && spaceCode.matches('^[a-z0-9]{3,20}$')
        && request.resource.data.keys().hasAll([
          'title', 'colors', 'popularGroups', 'createdAt', 'ownerUid', 'stats'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'colors', 'popularGroups', 'createdAt',
          'imagesEnabled', 'ownerUid', 'stats'
        ])
        && validShortText(request.resource.data.title, 1, 100)
        && validOptionalText(request.resource.data, 'description', 500)
        && request.resource.data.colors is map
        && request.resource.data.colors.keys().hasAll(['primary', 'secondary', 'accent'])
        && request.resource.data.colors.keys().hasOnly(['primary', 'secondary', 'accent'])
        && validHexColor(request.resource.data.colors.primary)
        && validHexColor(request.resource.data.colors.secondary)
        && validHexColor(request.resource.data.colors.accent)
        && validStringList(request.resource.data.popularGroups, 12, 60)
        && (
          !('imagesEnabled' in request.resource.data)
          || request.resource.data.imagesEnabled == false
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.ownerUid == request.auth.uid
        && validInitialStats(request.resource.data.stats);

      allow update, delete: if false;
    }

    match /messages/{messageId} {
      function likePath() {
        return /databases/$(database)/documents/messages/$(messageId)/likes/$(request.auth.uid);
      }

      function validRepost(data) {
        return !('repostedFrom' in data)
          || (
            validShortText(data.repostedFrom, 1, 128)
            && exists(/databases/$(database)/documents/messages/$(data.repostedFrom))
            && get(/databases/$(database)/documents/messages/$(data.repostedFrom)).data.spaceCode == data.spaceCode
            && get(/databases/$(database)/documents/messages/$(data.repostedFrom)).data.content == data.content
          );
      }

      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 200;

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'from', 'to', 'content', 'timestamp', 'color', 'likes',
          'spaceCode', 'authorUid'
        ])
        && request.resource.data.keys().hasOnly([
          'from', 'to', 'content', 'timestamp', 'color', 'likes',
          'spaceCode', 'authorUid', 'repostedFrom', 'repostComment', 'imageUrl'
        ])
        && validShortText(request.resource.data.from, 1, 80)
        && validStringList(request.resource.data.to, 10, 80)
        && validShortText(request.resource.data.content, 10, 500)
        && validHexColor(request.resource.data.color)
        && request.resource.data.likes == 0
        && request.resource.data.spaceCode.matches('^[a-z0-9]{3,20}$')
        && exists(/databases/$(database)/documents/spaces/$(request.resource.data.spaceCode))
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.timestamp == request.time
        && validOptionalText(request.resource.data, 'repostComment', 200)
        && validOptionalText(request.resource.data, 'imageUrl', 2048)
        && (
          !('imageUrl' in request.resource.data)
          || (
            get(/databases/$(database)/documents/spaces/$(request.resource.data.spaceCode)).data.imagesEnabled == true
            && request.resource.data.imageUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')
          )
        )
        && validRepost(request.resource.data);

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes is int
        && (
          (
            request.resource.data.likes == resource.data.likes + 1
            && !exists(likePath())
            && existsAfter(likePath())
          )
          || (
            resource.data.likes > 0
            && request.resource.data.likes == resource.data.likes - 1
            && exists(likePath())
            && !existsAfter(likePath())
          )
        );

      allow delete: if false;

      match /likes/{userId} {
        allow get: if signedIn() && userId == request.auth.uid;
        allow list: if false;

        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.keys().hasAll(['userId', 'createdAt'])
          && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/messages/$(messageId)).data.likes
            == get(/databases/$(database)/documents/messages/$(messageId)).data.likes + 1;

        allow update: if false;

        allow delete: if signedIn()
          && userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/messages/$(messageId)).data.likes
            == get(/databases/$(database)/documents/messages/$(messageId)).data.likes - 1;
      }

      match /replies/{replyId} {
        allow get: if true;
        allow list: if request.query.limit != null && request.query.limit <= 100;

        allow create: if signedIn()
          && exists(/databases/$(database)/documents/messages/$(messageId))
          && request.resource.data.keys().hasAll([
            'from', 'content', 'timestamp', 'authorUid'
          ])
          && request.resource.data.keys().hasOnly([
            'from', 'content', 'timestamp', 'authorUid'
          ])
          && validShortText(request.resource.data.from, 1, 80)
          && validShortText(request.resource.data.content, 5, 300)
          && request.resource.data.timestamp == request.time
          && request.resource.data.authorUid == request.auth.uid;

        allow update, delete: if false;
      }
    }

    // Legacy group documents are no longer used. Suggestions and counts are
    // derived from space configuration and messages in the client.
    match /groups/{groupId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
