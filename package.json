{
  "name": "yourwall-message-board",
  "version": "1.0.0",
  "private": true,
  "description": "YourWall - A beautiful message platform for events and communities",
  "scripts": {
    "dev": "rm -f .next/dev/lock 2>/dev/null && next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "nuke": "pkill -f 'next dev' || true && rm -rf .next"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "date-fns": "^4.1.0",
    "firebase": "^11.1.0",
    "framer-motion": "^11.15.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.469.0",
    "next": "^16.0.10",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@csstools/postcss-oklab-function": "^4.0.12",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "postcss": "^8.5.6",
    "postcss-preset-env": "^10.4.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  }
}
