{
  "name": "yourwall-message-board",
  "version": "1.0.0",
  "private": true,
  "description": "YourWall - A beautiful message platform for events and communities",
  "scripts": {
    "dev": "rm -f .next/dev/lock 2>/dev/null && next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "test:rules": "firebase emulators:exec --project demo-yourwall --only firestore,storage \"node --test tests/firebase-rules.test.mjs\"",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage --project yourwall-message-board",
    "nuke": "pkill -f 'next dev' || true && rm -rf .next"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "date-fns": "^4.1.0",
    "firebase": "12.17.0",
    "framer-motion": "^11.15.0",
    "html2canvas-pro": "^2.3.8",
    "lucide-react": "^0.469.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@csstools/postcss-oklab-function": "^4.0.12",
    "@firebase/rules-unit-testing": "5.0.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "firebase-tools": "^15.25.1",
    "postcss": "8.5.25",
    "postcss-preset-env": "^10.4.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  }
}
